# Real values are set in Vercel project environment variables, never committed here.
RESEND_API_KEY=
# Inbox that receives seller-enquiry notifications (/api/contact).
LEAD_TO_EMAIL=
# Verified Resend sender, e.g. "MoKan Property Buyers <leads@mokanpropertybuyers.com>".
# Never hardcode this — a missing value must fail the request, not fall back
# to an invented address (see src/lib/leads.ts assertLeadDeliveryConfigured).
LEAD_FROM_EMAIL=
NEXT_PUBLIC_GA_ID=
